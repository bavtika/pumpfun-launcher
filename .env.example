# Copy to .env and fill real values. Never commit .env.

# Shared access password — required on every login and register.
SITE_PASSWORD=change-me-now

# Encrypts wallet private keys at rest (64 hex chars OR a passphrase of 16+ chars).
WALLET_ENCRYPTION_KEY=change-this-to-a-long-random-passphrase

# Neon / Vercel Postgres connection string.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Prefer a dedicated RPC (Helius, QuickNode, …) in production.
RPC_URL=https://api.mainnet-beta.solana.com
PORT=3000

# Optional GPU vanity (RunPod serverless). Leave empty to disable.
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
